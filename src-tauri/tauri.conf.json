{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JTech Browser",
  "mainBinaryName": "jtech-browser",
  "version": "../package.json",
  "identifier": "com.jtech.browser",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "JTech",
    "category": "Productivity",
    "shortDescription": "JTech Browser",
    "longDescription": "JTech Browser",
    "copyright": "Copyright (c) bartels",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}

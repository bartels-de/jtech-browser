{
  "name": "jtech-browser",
  "productName": "JTech Browser",
  "version": "0.8.3",
  "description": "Gaming-orientierter Browser auf Electron-Basis",
  "main": "src/main/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test tests/*.js",
    "build": "electron-builder",
    "build:dir": "electron-builder --dir"
  },
  "build": {
    "appId": "com.jtech.browser",
    "productName": "JTech Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "src/renderer/assets/logo-256.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "JTech-Browser-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "bartels-de",
      "repo": "jtech-browser",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "adm-zip": "^0.6.1",
    "electron-chrome-extensions": "^4.10.0",
    "electron-updater": "^6.8.11",
    "koffi": "^2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bartels-de/jtech-browser.git"
  }
}
